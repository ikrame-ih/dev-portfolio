# Copy to web/.env for local API testing (Vite does not load these into the browser).
# Production: Vercel → Project → Settings → Environment Variables.

# Guest book (Upstash Redis) — both vars in the same environments (Production + Preview)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: remote guest book locally — run `vercel dev` from web/
# VITE_USE_REMOTE_BOWS=true

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
