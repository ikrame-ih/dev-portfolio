# Copy to web/.env for local API testing (Vite does not load these into the browser).
# In production, set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Guest book (Upstash Redis) ---
# Create a database at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contact form (Resend) ---
# 1. Sign up at https://resend.com/
# 2. Create an API key → RESEND_API_KEY
# 3. CONTACT_TO_EMAIL = your inbox (e.g. ikihga2223@gmail.com)
# 4. For testing, Resend sends from onboarding@resend.dev (CONTACT_FROM_EMAIL optional)
# 5. For production, verify a domain in Resend and set CONTACT_FROM_EMAIL e.g. Portfolio <hello@yourdomain.com>
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
